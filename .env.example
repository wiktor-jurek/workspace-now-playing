# Public URL of this instance, no trailing slash. OAuth redirect URIs are derived from it.
BASE_URL=https://now-playing.example.com

# Signs session cookies and encrypts stored tokens. Generate with: openssl rand -hex 32
# Changing it logs everyone out and makes stored tokens unreadable.
SECRET_KEY=

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: restrict who can sign in (comma-separated). Empty = anyone.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Optional
POLL_INTERVAL=15
SOURCE_URL=https://github.com/wiktor-jurek/workspace-now-playing
